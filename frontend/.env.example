# Base URL of the backend API. Defaults to `/api` (proxied by Vite to http://localhost:3001 in dev).
VITE_API_URL=/api

# Socket.IO base URL — the backend hosts the realtime server on the same port
# as the REST API. Required for live delivery tracking and live in-app
# notifications; without it the client tries Socket.IO on the Vite dev server
# (:5173), which serves no handshake and live updates silently fail.
VITE_SOCKET_URL=http://localhost:3001

# ImageKit (Step 44) — PUBLIC credentials only. Never put the private key here;
# the backend signs uploads with it via /api/v1/uploads/imagekit-auth.
VITE_IMAGEKIT_PUBLIC_KEY=public_xxx
VITE_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/YOUR_IMAGEKIT_ID
