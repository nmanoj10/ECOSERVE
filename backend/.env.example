# Server
NODE_ENV=development
PORT=3001

# CORS — origin of the frontend. Add extra allowed origins (comma-separated)
# via CORS_ORIGINS if the API is served to more than one frontend.
CLIENT_URL=http://localhost:5173
# CORS_ORIGINS=https://app.example.com,https://staging.example.com

# Set to true ONLY when running behind a reverse proxy (Render, Railway,
# nginx). Enables correct rate limiting via X-Forwarded-For.
TRUST_PROXY=false

# PostgreSQL connection string (used by Prisma + pg adapter)
DATABASE_URL=postgresql://user:password@host:5432/ecoserve?sslmode=require

# Supabase project (Auth). Get these from your Supabase dashboard.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx
SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json

# ImageKit (Step 44) — from your ImageKit dashboard → Settings → API Keys.
# Only IMAGEKIT_PUBLIC_KEY + IMAGEKIT_URL_ENDPOINT may ship to the frontend;
# IMAGEKIT_PRIVATE_KEY must stay server-side (used to sign client uploads).
IMAGEKIT_PUBLIC_KEY=public_xxx
IMAGEKIT_PRIVATE_KEY=private_xxx
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/YOUR_IMAGEKIT_ID

# Python ai-service (food classifier) — the backend calls POST /predict-url
# with the ImageKit image URL when a donation is created. Optional: leave
# empty to skip dish enrichment (rule-based freshness scoring still runs).
AI_SERVICE_URL=http://localhost:8000

# Background jobs — optional tuning of sweep intervals (ms).
# Rescue sweep (Phase 19): alerts volunteers about expiring unclaimed food.
RESCUE_INTERVAL_MS=600000
# Phase 37 — expired-donation sweep: marks past-expiry donations EXPIRED.
EXPIRY_JOB_INTERVAL_MS=900000
# Phase 37 — reminder sweep: upcoming pickup / pending acceptance / nearing expiry.
REMINDER_JOB_INTERVAL_MS=600000
# Phase 37 — analytics rollup: recomputes the daily Analytics table rows.
ANALYTICS_JOB_INTERVAL_MS=21600000
