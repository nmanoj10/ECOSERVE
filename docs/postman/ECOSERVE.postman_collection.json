    {
      "name": "3 · Donation",
      "item": [
        {
          "name": "POST /donations (create listing)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{donorToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"foodName\": \"Paneer Biryani (API Test)\",\n  \"category\": \"Cooked\",\n  \"quantity\": 8,\n  \"unit\": \"kg\",\n  \"preparedAt\": \"{{preparedAt}}\",\n  \"expiryTime\": \"{{expiryTime}}\",\n  \"pickupTime\": \"{{pickupTime}}\",\n  \"pickupAddress\": \"12 MG Road, Bengaluru, Karnataka\",\n  \"latitude\": 12.9716,\n  \"longitude\": 77.5946,\n  \"description\": \"Freshly cooked — created by the Postman API test suite.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/donations" }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Fresh timestamps (relative to now) so the listing never",
                  "// lands already-expired on re-runs.",
                  "const now = Date.now();",
                  "pm.collectionVariables.set('preparedAt', new Date(now + 60 * 60 * 1000).toISOString());",
                  "pm.collectionVariables.set('pickupTime', new Date(now + 2 * 60 * 60 * 1000).toISOString());",
                  "pm.collectionVariables.set('expiryTime', new Date(now + 4 * 60 * 60 * 1000).toISOString());"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('donation created with AI prediction', () => {",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(pm.response.json().donation.status).to.eql('AVAILABLE');",
                  "  pm.expect(pm.response.json().prediction).to.have.property('freshnessScore');",
                  "});",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('donationId', json.donation.id);",
                  "pm.collectionVariables.set('donationPriority', json.prediction ? String(json.prediction.priority) : 'n/a');"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET /donations (list, donor scoped)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{donorToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/donations?page=1&limit=10&search=Biryani",
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "search", "value": "Biryani" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('list returns the created donation', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().pagination.total).to.be.at.least(1);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET /donations/:id (detail + timeline)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{donorToken}}" }],
            "url": { "raw": "{{baseUrl}}/donations/{{donationId}}" }
          },
          "event": [
            {
