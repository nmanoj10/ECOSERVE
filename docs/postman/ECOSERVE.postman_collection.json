          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('health returns ok', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().status).to.eql('ok');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
