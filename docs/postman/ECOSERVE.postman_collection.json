            "event": [
              {
                "listen": "prerequest",
                "script": {
                  "exec": [
                    "// Capture a PENDING ngo id if not already set.",
                    "if (!pm.collectionVariables.get('ngoId')) {",
                    "  const res = await pm.sendRequest({",
                    "    url: pm.collectionVariables.get('baseUrl') + '/admin/ngos?verification=PENDING&limit=1',",
                    "    method: 'GET',",
                    "    header: { 'Authorization': 'Bearer ' + pm.collectionVariables.get('adminToken') }",
                    "  });",
                    "  const body = res.json();",
                    "  if (body.ngos && body.ngos.length > 0) {",
                    "    pm.collectionVariables.set('ngoId', body.ngos[0].id);",
                    "  }",
                    "}"
                  ],
