        {
          "name": "Sign up Donor (first run only)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "apikey", "value": "{{supabaseAnonKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{donorEmail}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": { "raw": "{{supabaseUrl}}/auth/v1/signup" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.access_token) {",
                  "  pm.collectionVariables.set('donorToken', json.access_token);",
                  "  pm.collectionVariables.set('donorRefreshToken', json.refresh_token);",
                  "  pm.collectionVariables.set('donorUserId', json.user.id);",
                  "}",
                  "// 200 = created, 400 = exists / confirmation pending — login instead.",
                  "pm.test('signup accepted or user already exists', () => {",
                  "  pm.expect([200, 201, 400, 422]).to.include(pm.response.code);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
